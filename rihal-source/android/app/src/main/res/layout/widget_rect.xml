<?xml version="1.0" encoding="utf-8"?>
<!-- Rectangle widget. Every text auto-sizes, so the content grows and shrinks with the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.27"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:maxHeight="26dp"
                android:paddingVertical="3dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_moon" />

            <TextView
                android:id="@+id/w_ar"
            android:textSize="19sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="الظهر"
                android:textColor="#F1D9A2"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_time"
            android:textSize="34sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.48"
            android:autoSizeMaxTextSize="80sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="11:31"
            android:textColor="#F5F0E4" />

        <Chronometer
            android:id="@+id/w_chrono"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:textColor="#A9B2CC" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:maxHeight="20dp"
                android:paddingVertical="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_pin" />

            <TextView
                android:id="@+id/w_mlabel"
            android:textSize="9sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="NEAREST"
                android:textColor="#A9B2CC" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_mname"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.48"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:text="Masjid Al-Noor"
            android:textColor="#F5F0E4" />

        <TextView
            android:id="@+id/w_mdist"
            android:textSize="11sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.30"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:text="350 m · 4 min walk"
            android:textColor="#A9B2CC" />
    </LinearLayout>
</LinearLayout>
